entrypoint = "main.py"
modules = ["nodejs-24", "python-3.11"]

[deployment]
build = ["python3", "-m", "pip", "install", "--disable-pip-version-check", "-r", "requirements.txt"]
run = ["python3", "-u", "main.py"]
deploymentTarget = "vm"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rakan Bot"

[[workflows.workflow]]
name = "Rakan Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
